.superpowers/

# Fork-specific entries (from medplum-scheduling-demo/.gitignore)
# Note: package-lock.json is intentionally NOT ignored — this repo needs its
# lockfile tracked for reproducible installs.
logs
*.log
npm-debug.log*
dist-ssr
*.local
data/core/example-bots.json
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
node_modules

# Per-machine seeding upload progress (Task 9) — tracks which files have
# already been uploaded to whichever target Medplum project; not shared state.
.seed-manifest.json
