.env
.claude/
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# Reference-only local clones used for source fact-checking during design —
# not part of this project, never meant to be committed here.
medplum/
medplum-scheduling-demo/

# Subagent-driven-development scratch workspace (ledger, task briefs/reports) —
