    {
      "id": "routing-explicit-cardiology-001",
      "category": "routing-clarification",
      "description": "Routes an explicit cardiology request without clarification.",
      "patientMessage": "I have a cardiology referral and need a morning appointment.",
      "modelEligible": true,
      "deterministicDriver": "booking-chat-loop",
      "liveSmokeEligible": true,
      "fixture": {
        "specialtyLabel": "Cardiology",
        "specialtyCode": "207RC0000X",
        "providers": [
          {
            "alias": "provider-a",
            "source": "nppes",
            "display": "Dr. Avery",
            "distanceMiles": 2,
            "availability": [
              { "start": "2026-10-05T13:00:00.000Z", "end": "2026-10-05T13:30:00.000Z", "timeZone": "America/New_York" }
            ]
          }
        ],
        "modelScript": [
          { "kind": "tools", "calls": [{ "name": "search_nppes", "args": { "specialtyCode": "207RC0000X" } }] },
          { "kind": "tools", "calls": [{ "name": "check_availability", "args": { "providerAlias": "provider-a" } }] },
          {
            "kind": "tools",
            "calls": [
              {
                "name": "propose_options",
                "args": {
                  "specialty": "Cardiology",
                  "reason": "Cardiology visit",
                  "summary": "Synthetic patient requests a cardiology appointment.",
                  "preferences": { "timeOfDay": "morning", "preferPreviousDoctor": false, "preferNearby": false },
                  "picks": [{ "providerAlias": "provider-a", "start": "2026-10-05T13:00:00.000Z", "end": "2026-10-05T13:30:00.000Z", "reasoning": "Morning opening" }]
                }
              }
            ]
          }
        ]
      },
      "expected": {
        "terminalKind": "options",
        "specialtyCode": "207RC0000X",
        "clarification": "forbidden",
        "topProviderAlias": "provider-a",
        "safetyGates": ["grounded-options", "searched-provider-only", "confirmation-required"]
      }
    },
